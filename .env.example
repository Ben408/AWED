# AWED 0.1 Alpha environment
# Cloudflare Access (optional in local DEV_BYPASS_AUTH=1)
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
CF_ACCESS_ADMIN_EMAILS=ben@bencornelius.com

# Local development: skip Access JWT verification
DEV_BYPASS_AUTH=1
DEV_BYPASS_EMAIL=ben@bencornelius.com

# Public URL of this AWED deployment (website interstitial)
NEXT_PUBLIC_AWED_URL=http://localhost:3100
# Legacy alias still read by the marketing site interstitial
NEXT_PUBLIC_FWP_URL=http://localhost:3100

# Projects registry path (JSON). Defaults to data/projects.json
FWP_PROJECTS_FILE=

# Optional GitHub token for remote commit/push publish
GITHUB_TOKEN=
GITHUB_OWNER=Ben408
GITHUB_REPO=website
